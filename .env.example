PORT=3000
BACKEND_PUBLIC_URL=http://localhost:3000
JWT_SECRET=replace-with-a-strong-random-secret
SESSION_SECRET=replace-with-a-strong-random-secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=true
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=30
ACCESS_COOKIE_NAME=companio_at
REFRESH_COOKIE_NAME=companio_rt
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=false
EMAIL_FROM=Companio <your_gmail@gmail.com>


# Required: Firebase Firestore (pick one method)
# Method A (recommended): paste full service-account JSON in one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Method B: provide split fields instead of JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: required only for Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI itinerary assistant (fallback planner still works if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
